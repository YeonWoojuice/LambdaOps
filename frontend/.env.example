# Demo is the default when VITE_DATA_MODE is omitted. Set live only after AWS verification.
VITE_DATA_MODE=demo

# For live mode, change VITE_DATA_MODE above to live, run at http://localhost:8765,
# and fill these public identifiers only.
# VITE_INCIDENT_API_BASE_URL=https://REPLACE.execute-api.ap-northeast-2.amazonaws.com
# VITE_COGNITO_ISSUER=https://cognito-idp.ap-northeast-2.amazonaws.com/REPLACE_POOL_ID
# VITE_COGNITO_CLIENT_ID=REPLACE_PUBLIC_OPERATOR_CLIENT_ID
# Never put passwords, JWTs, refresh tokens, or client secrets in VITE_ variables.
